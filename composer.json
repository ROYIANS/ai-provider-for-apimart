{
    "name": "royians/ai-provider-for-apimart",
    "description": "APIMart provider for the PHP AI Client SDK, available as a Composer package and WordPress plugin.",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "ai",
        "apimart",
        "wordpress",
        "llm"
    ],
    "authors": [
        {
            "name": "ROYIANS",
            "homepage": "https://github.com/ROYIANS"
        },
        {
            "name": "WordPress AI Team",
            "homepage": "https://make.wordpress.org/ai/"
        }
    ],
    "homepage": "https://github.com/ROYIANS/ai-provider-for-apimart",
    "support": {
        "issues": "https://github.com/ROYIANS/ai-provider-for-apimart/issues",
        "source": "https://github.com/ROYIANS/ai-provider-for-apimart"
    },
    "require": {
        "php": ">=7.4",
        "wordpress/php-ai-client": "^1.3.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/php-compatibility": "dev-develop",
        "phpstan/phpstan": "~2.1",
        "phpunit/phpunit": "^9.6",
        "slevomat/coding-standard": "^8.20",
        "squizlabs/php_codesniffer": "^3.13.6 || ^4.0.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "WordPress\\ApimartAiProvider\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WordPress\\ApimartAiProvider\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "7.4"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "@phpcs",
            "@phpstan"
        ],
        "phpcbf": "phpcbf",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyze --memory-limit=256M",
        "test": "phpunit"
    }
}
